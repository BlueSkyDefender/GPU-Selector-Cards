    {
      "label": "3DConsoleBridge-AR",
      "url": "https://github.com/NTM-3D/3DConsoleBridge-AR",
      "when": {
        "mode": "ar"
      }
    },

    {
      "label": "3DConsoleBridge-SR",
      "url": "https://github.com/NTM-3D/3DConsoleBridge-SR",
      "when": {
