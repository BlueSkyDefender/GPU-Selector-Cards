{
  "cardVersion": "1.1",
  "name": "Stereo Loom",
  "author": "effcol",
  "cardBy": "BlueSkyDefender",
  "cardByUrl": "https://github.com/BlueSkyDefender",
  "tagline": "Stereo 3D on your 3D display. Part of Stereopticon",
  "description": "Weaves stereo 3D onto 3D displays. It was called SR Loom before.",
  "icon": "data:image/png;base64,",
  "backgroundArt": "data:image/jpeg;base64,",
  "website": "https://github.com/Stereopticon-Org/StereoLoom",
  "sourceUrl": "https://github.com/Stereopticon-Org/StereoLoom",
  "license": "MIT",
  "licenseUrl": "https://github.com/Stereopticon-Org/StereoLoom/blob/main/LICENSE",
  "locked": true,

  "downloads": [
    {
      "id": "stereoloom",
      "github": "Stereopticon-Org/StereoLoom",
      "asset": "StereoLoom.exe"
    }
  ],

  "launch": {
    "from": "stereoloom/StereoLoom.exe",
    "label": "Launch Stereo Loom"
  },

  "ui": {
    "buttonColor": "#7c3aed",
    "buttonHoverColor": "#6d28d9",
    "hoverBorderColor": "#a78bfa",
    "modes": {
      "id": "page",
      "position": "top",
      "options": [
        {
          "value": "about",
          "label": "About",
          "color": "#a78bfa",
          "description": "Shows stereo 3D from games and video on your 3D display.\n1. No glasses on Samsung Odyssey 3D, Acer SpatialLabs and other LeiaSR screens. Those need the SR Platform runtime from your display's maker.\n2. Also for Zondision, NVIDIA 3D Vision, anaglyph glasses, Side-by-Side, Top-and-Bottom, HDMI Frame Packing and Katanga.\n3. Plays any 3D format: Side-by-Side, Top-and-Bottom, anaglyph and more.\n4. Whole screen, one window, or a small floating window.\n5. It runs in the tray. Click its icon to open it.\n6. Play games in borderless or windowed mode. Exclusive full screen can't be captured."
        },

        {
          "value": "head",
          "label": "Head Tracking",
          "color": "#22d3ee",
          "description": "Your SR display's camera becomes head tracking for games.\n1. No extra hardware needed.\n2. Works with OpenTrack, FreeTrack and TrackIR games.\n3. For example DCS World, MSFS, iRacing and Elite Dangerous.\n4. Turn it on or off in the tray menu, under Head Tracking."
        },

        {
          "value": "keys",
          "label": "Keys",
          "color": "#f472b6",
          "description": "Shortcut keys:\n1. Ctrl+Alt+W: turn 3D on or off.\n2. Ctrl+Alt+F: switch full screen and floating window.\n3. Ctrl+Alt+C: make the window you are using 3D.\n4. Ctrl+Alt+R: re-center head tracking.\n5. Ctrl+Alt+[ and Ctrl+Alt+]: Convergence down and up.\n6. Ctrl+Alt+- and Ctrl+Alt+=: Anti-Crosstalk down and up.\n\nLeft-click the tray icon for its panel. Right-click for a quick menu."
        }
      ]
    }
  }
}
